
from pathlib import Path

import numpy as np
import pandas as pd

# =========================================================
# 1. CONFIGURATION
# =========================================================

ROOT = Path(__file__).resolve().parent.parent

DATA_PATH = ROOT / "data" / "processed" / "training_data.csv"
MODEL_PATH = ROOT / "model" / "regression_model.npz"

CHUNK_SIZE = 50_000
TEST_FRACTION = 0.20
SEED = 42
EVAL_SAMPLE_SIZE = 100_000

NUMERIC_FEATURES = [
    "total_copies",
    "checkouts_last_1d",
    "checkouts_last_3d",
    "checkouts_last_7d",
    "returns_last_7d",
    "demand_growth",
    "days_to_first_exam",
]

DEPARTMENTS = [
    "CSE", "IT", "ECE", "EEE", "Mechanical", "Civil",
    "Chemical", "Biotechnology", "Biomedical", "Aerospace",
    "Production", "Automotive", "Mathematics", "Physics",
    "Chemistry", "Common Engineering",
]

EXAM_TYPES = ["CAT1", "CAT2", "FAT"]
TARGET = "target_next_7d_checkouts"

COLUMNS = NUMERIC_FEATURES + [
    "department",
    "exam_type",
    TARGET,
]

# One intercept + numeric + department + exam type features.
FEATURE_COUNT = (
    1
    + len(NUMERIC_FEATURES)
    + len(DEPARTMENTS)
    + len(EXAM_TYPES)
)


# =========================================================
# 2. CLEAN DATA
# =========================================================

def clean_chunk(df):
    df = df.dropna(subset=COLUMNS).copy()

    numeric_columns = NUMERIC_FEATURES + [TARGET]

    for col in numeric_columns:
        df[col] = pd.to_numeric(df[col], errors="coerce")

    df = df.replace([np.inf, -np.inf], np.nan)
    df = df.dropna(subset=numeric_columns)

    nonnegative_columns = [
        "total_copies",
        "checkouts_last_1d",
        "checkouts_last_3d",
        "checkouts_last_7d",
        "returns_last_7d",
        TARGET,
    ]

    for col in nonnegative_columns:
        df = df[df[col] >= 0]

    df = df[
        (df["total_copies"] > 0)
        & (df["days_to_first_exam"] >= 0)
        & df["department"].isin(DEPARTMENTS)
        & df["exam_type"].isin(EXAM_TYPES)
    ]

    return df


# =========================================================
# 3. CONVERT FEATURES INTO NUMBERS
# =========================================================

def make_features(df):
    numeric = df[NUMERIC_FEATURES].to_numpy(dtype=np.float64)

    department = np.column_stack([
        (df["department"].to_numpy() == name).astype(np.float64)
        for name in DEPARTMENTS
    ])

    exam = np.column_stack([
        (df["exam_type"].to_numpy() == name).astype(np.float64)
        for name in EXAM_TYPES
    ])

    intercept = np.ones((len(df), 1), dtype=np.float64)

    return np.column_stack([
        intercept,
        numeric,
        department,
        exam,
    ])


# =========================================================
# 4. REPRODUCIBLE TRAIN / TEST SPLIT
# =========================================================

def is_training_row(row_numbers):
    # Deterministic pseudo-random assignment based on the
    # original CSV row number. No global RNG state required.
    values = (
        row_numbers.astype(np.uint64) * np.uint64(1103515245)
        + np.uint64(SEED)
    ) % np.uint64(2147483647)

    fraction = values / 2147483647.0
    return fraction >= TEST_FRACTION


# =========================================================
# 5. TRAIN MODEL IN CHUNKS
# =========================================================

def train_model():
    print("Pass 1/2: training regression model...", flush=True)

    xtx = np.zeros((FEATURE_COUNT, FEATURE_COUNT), dtype=np.float64)
    xty = np.zeros(FEATURE_COUNT, dtype=np.float64)

    training_rows = 0
    original_row = 0

    for chunk in pd.read_csv(
        DATA_PATH,
        usecols=COLUMNS,
        chunksize=CHUNK_SIZE,
    ):
        chunk["_row_number"] = np.arange(
            original_row,
            original_row + len(chunk),
            dtype=np.int64,
        )
        original_row += len(chunk)

        chunk = clean_chunk(chunk)

        if chunk.empty:
            continue

        row_numbers = chunk["_row_number"].to_numpy()
        chunk = chunk.loc[is_training_row(row_numbers)]

        if chunk.empty:
            continue

        X = make_features(chunk)
        y = chunk[TARGET].to_numpy(dtype=np.float64)

        # Accumulate the least-squares matrices.
        xtx += X.T @ X
        xty += X.T @ y
        training_rows += len(y)

        if training_rows // 500_000 != (
            training_rows - len(y)
        ) // 500_000:
            print(
                f"Training rows processed: {training_rows:,}",
                flush=True,
            )

    if training_rows == 0:
        raise ValueError(
            "No valid training rows found. Check the dataset."
        )

    print("Calculating coefficients...", flush=True)

    # Solve the accumulated least-squares problem.
    # lstsq avoids explicitly calculating the matrix inverse.
    coefficients = np.linalg.lstsq(xtx, xty, rcond=None)[0]

    MODEL_PATH.parent.mkdir(parents=True, exist_ok=True)

    np.savez(
        MODEL_PATH,
        coefficients=coefficients,
        numeric_features=np.array(NUMERIC_FEATURES),
        departments=np.array(DEPARTMENTS),
        exam_types=np.array(EXAM_TYPES),
    )

    print(f"Training rows: {training_rows:,}", flush=True)
    print(f"Saved model: {MODEL_PATH}", flush=True)

    return coefficients, training_rows


# =========================================================
# 6. EVALUATE ON HELD-OUT DATA
# =========================================================

def evaluate_model(coefficients, training_rows):
    print("\nPass 2/2: evaluating model...", flush=True)

    rng = np.random.default_rng(SEED)

    actual_sample = np.empty(EVAL_SAMPLE_SIZE, dtype=np.float64)
    predicted_sample = np.empty(EVAL_SAMPLE_SIZE, dtype=np.float64)

    sampled = 0
    test_rows = 0
    original_row = 0

    for chunk in pd.read_csv(
        DATA_PATH,
        usecols=COLUMNS,
        chunksize=CHUNK_SIZE,
    ):
        chunk["_row_number"] = np.arange(
            original_row,
            original_row + len(chunk),
            dtype=np.int64,
        )
        original_row += len(chunk)

        chunk = clean_chunk(chunk)

        if chunk.empty:
            continue

        row_numbers = chunk["_row_number"].to_numpy()
        chunk = chunk.loc[~is_training_row(row_numbers)]

        if chunk.empty:
            continue

        X = make_features(chunk)
        y = chunk[TARGET].to_numpy(dtype=np.float64)
        predictions = X @ coefficients

        # Reservoir sampling gives a bounded-size test sample.
        for actual, predicted in zip(y, predictions):
            test_rows += 1

            if sampled < EVAL_SAMPLE_SIZE:
                actual_sample[sampled] = actual
                predicted_sample[sampled] = predicted
                sampled += 1
            else:
                j = int(rng.integers(0, test_rows))
                if j < EVAL_SAMPLE_SIZE:
                    actual_sample[j] = actual
                    predicted_sample[j] = predicted

        if test_rows and test_rows % 500_000 < CHUNK_SIZE:
            print(f"Test rows scanned: {test_rows:,}", flush=True)

    if sampled == 0:
        raise ValueError("No valid test rows found.")

    actual = actual_sample[:sampled]
    predicted = predicted_sample[:sampled]

    errors = actual - predicted

    mae = np.mean(np.abs(errors))
    rmse = np.sqrt(np.mean(errors ** 2))

    ss_total = np.sum((actual - np.mean(actual)) ** 2)
    ss_residual = np.sum(errors ** 2)

    r2 = (
        1.0 - ss_residual / ss_total
        if ss_total > 0
        else float("nan")
    )

    print("\n========== MODEL RESULTS ==========")
    print(f"Training rows:       {training_rows:,}")
    print(f"Test rows available: {test_rows:,}")
    print(f"Test sample size:    {sampled:,}")
    print(f"MAE:                 {mae:.4f}")
    print(f"RMSE:                {rmse:.4f}")
    print(f"R-squared:           {r2:.4f}")
    print("===================================")


# =========================================================
# 7. MAIN
# =========================================================

def main():
    if not DATA_PATH.exists():
        raise FileNotFoundError(
            f"Training dataset not found: {DATA_PATH}"
        )

    print(f"Dataset: {DATA_PATH}")
    print(f"Chunk size: {CHUNK_SIZE:,}")
    print(f"Feature count: {FEATURE_COUNT}", flush=True)

    coefficients, training_rows = train_model()
    evaluate_model(coefficients, training_rows)

    print("\nTraining and evaluation finished.", flush=True)


if __name__ == "__main__":
    main()
